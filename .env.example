# Copy to .env and fill in. .env is gitignored.

# Primary discovery driver.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Secondary provider. Used to prove the LLMProvider seam, to record a
# comparative discovery run, and to invoke a Claude-recorded capability
# from a different vendor's agent.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Which provider drives discovery by default: anthropic | openai
CUA_PROVIDER=anthropic

# Mock target app
MOCKAPP_HOST=127.0.0.1
MOCKAPP_PORT=8080

# Operator console
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8081
