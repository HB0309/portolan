# Copy to .env and fill in. .env is gitignored.

# Primary discovery driver.
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 is the default. claude-sonnet-5 is roughly a third of the
# cost and fine for iterating on prompts; use opus for the committed run.
ANTHROPIC_MODEL=claude-opus-5

# Secondary provider. Used to prove the LLMProvider seam, to record a
# comparative discovery run, and to invoke a Claude-recorded capability
# from a different vendor's agent.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# The OpenAI adapter also speaks to anything exposing an OpenAI-compatible
# chat-completions endpoint with tool calling -- Google's Gemini, Groq,
# OpenRouter, a local Ollama. Set the base URL and put that provider's key in
# OPENAI_API_KEY. Useful for a free-tier smoke test; tool-call fidelity varies,
# so a run that works there is evidence the loop is sound, not that the model is.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

# Which provider drives discovery by default: anthropic | openai
CUA_PROVIDER=anthropic

# Mock target app. Change MOCKAPP_PORT here if 8080 is already in use --
# `python -m mockapp` and every `cua discover`/`cua replay` invocation both
# read this, so the two sides stay in agreement without needing --target
# passed by hand on every command.
MOCKAPP_HOST=127.0.0.1
MOCKAPP_PORT=8080

# Operator console. CONSOLE_PORT is read the same way, as --console-port's
# default. The console only ever binds to 127.0.0.1 -- it hands over a live
# local browser session, which is not something to expose beyond localhost.
CONSOLE_PORT=8081
